# ── InSightATS Backend — Environment Variables ──────────────────────────────
# Copy to .env locally or set in Hugging Face Space / Oracle VM secrets.

APP_ENV=production
PORT=8000
DB_PATH=/data/db.sqlite3
MODEL_DIR=/data/models
ALLOWED_ORIGINS=https://YOUR-APP.vercel.app

# Clerk JWT verification (required for recruiter batch-analyze from the React app)
# CLERK_ISSUER = ONE line: the JWT "issuer" URL from Clerk (NOT the JWKS public key PEM).
# Clerk Dashboard → Configure → API Keys → JWT issuer (looks like https://xxx.clerk.accounts.dev)
CLERK_ISSUER=https://charmed-racer-56.clerk.accounts.dev
# Optional: paste Clerk's full JWKS URL if it differs from {CLERK_ISSUER}/.well-known/jwks.json
CLERK_JWKS_URL=https://charmed-racer-56.clerk.accounts.dev/.well-known/jwks.json
# Optional: authorized party / audience if you restrict JWTs in Clerk
# CLERK_AUDIENCE=

ENABLE_SHAP=0
WEB_CONCURRENCY=1
