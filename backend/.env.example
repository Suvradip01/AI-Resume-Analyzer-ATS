# ── InSightATS Backend — Environment Variables ──────────────────────────────
# Copy to .env locally or set in Hugging Face Space / Oracle VM secrets.

APP_ENV=production
PORT=8000
DB_PATH=/data/db.sqlite3
MODEL_DIR=/data/models
ALLOWED_ORIGINS=https://YOUR-APP.vercel.app

# Clerk JWT verification (required for recruiter batch-analyze from the React app)
# CLERK_ISSUER = ONE line: the JWT "issuer" URL from Clerk (NOT the JWKS public key PEM).

ENABLE_SHAP=0
WEB_CONCURRENCY=1

# ── Redis Result Caching ─────────────────────────────────────────────────────
# Set REDIS_URL to cache ML pipeline results. Identical resume+JD pairs return
# in <5 ms instead of 5-30 s. Leave empty to disable caching (graceful fallback).
#
# Local:   REDIS_URL=redis://localhost:6379/0
# Upstash: REDIS_URL=rediss://:<password>@<host>.upstash.io:6379
# Docker:  REDIS_URL=redis://redis:6379/0
#
REDIS_URL=
# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600
